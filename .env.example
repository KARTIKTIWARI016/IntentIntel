# Copy to .env and fill in. Local SQLite is fine; swap to Postgres for the VM.
DATABASE_URL="file:./dev.db"

# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Supabase requires both a project URL and a publishable/anon key.
# For persistent Prisma storage, set DATABASE_URL to your Supabase Postgres connection string.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Free-tier safety: requests/min the worker will not exceed.
WORKER_RPM="8"

# Max grounded analyses per UTC day before overflow is queued for the next day.
DAILY_API_BUDGET="200"
